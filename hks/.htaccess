Options -Indexes

# SQL, log, backup dosyalarına web erişimi kapalı
<FilesMatch "\.(sql|bak|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# includes/ ve views/ klasörlerindeki PHP dosyalarına doğrudan web erişimi kapalı
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/.*\.php$ - [F,L]
    RewriteRule ^views/.*\.php$ - [F,L]
    RewriteRule ^operasyon/views/.*\.php$ - [F,L]
</IfModule>

# Eski include-only dosyalar (geriye dönük uyumluluk)
<FilesMatch "^(HksClient|HksRepository|HksConfig|helpers)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>
