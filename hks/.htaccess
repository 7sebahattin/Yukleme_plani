Options -Indexes

# Yedek / şema / log dosyalarına web erişimi kapalı
<FilesMatch "\.(sql|bak|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Include-only PHP dosyaları (class/helper) — doğrudan web erişimi kapalı.
# Not: PHP içinden require_once ile çağrılmaları dosya sistemi erişimi olduğu
# için bundan etkilenmez; yalnızca doğrudan HTTP isteği engellenir.
<FilesMatch "^(HksClient|HksRepository|HksConfig|helpers)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>
