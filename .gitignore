backups/
# Claude Code — paylaşılan proje ayarları DEPOYA GİRER (.claude/settings.json, .claude/hooks/,
# .claude/skills/, .claude/agents/, .claude/.htaccess). Yalnız kişisel/yerel dosyalar dışarıda kalır.
# (.claude/ web kökünde deploy edilir; .claude/.htaccess web erişimini tamamen kapatır.)
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/
.claude/agent-memory-local/
CLAUDE.local.md

# Migration / analiz çıktıları — tek seferlik, runtime'da gerekmez
scripts/*.sql
scripts/*.csv
scripts/staging_report_*.txt
backups/*.sql
backups/*.csv
deploy.log

# Geçici / yerel veritabanı dosyaları
*.sqlite
*.sqlite3
config/local.php

# Smoke testin geçici kopyası (çökerse kalabilir)
.smoke_record_excel_*.php

# Tarayıcı testinin geçici çıktısı (scripts/roles_modal_render.php)
_test_*.html

# Mail Merkezi çalışma dosyaları (kilitler, cron kalp atışı, çeviri durumu) — sunucuda üretilir, depoya girmez
storage/mail/*
!storage/mail/.htaccess

# Sipariş modülü belgeleri (yüklenen PDF/XLSX ve üretilen PKL) — sunucuda üretilir, depoya girmez
storage/siparis/*
!storage/siparis/.htaccess
