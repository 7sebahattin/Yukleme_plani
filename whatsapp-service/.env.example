# =============================================================================
# whatsapp-service/.env.example  →  `cp .env.example .env` ve doldur.
# .env DEPOYA GİRMEZ; gizli değer içerir.  Güçlü anahtar:  openssl rand -hex 32
# =============================================================================

# --- Evolution API ---------------------------------------------------------
# Global API anahtarı. AYNI değeri PHP tarafında config/local.php'ye yaz:
#   define('EVOLUTION_API_KEY', '<bu değer>');
EVOLUTION_API_KEY=

# Evolution imajının sürümü (latest KULLANMA: sürüm atlaması oturumu bozabilir).
EVOLUTION_IMAGE_TAG=v2.3.7

# Evolution'ın dinlediği arayüz/port. 127.0.0.1 = yalnız bu makine (önerilen).
# PHP uygulaması başka sunucudaysa ters vekil (HTTPS) kur ya da 0.0.0.0 + güvenlik duvarı.
EVOLUTION_BIND=127.0.0.1
EVOLUTION_PORT=8080
# Evolution'ın kendini tanıttığı adres (QR/medya bağlantıları için).
EVOLUTION_SERVER_URL=http://localhost:8080

# --- PostgreSQL (Evolution'ın oturum/mesaj deposu) -------------------------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
POSTGRES_DB=evolution

# --- Webhook (Evolution → PHP) ---------------------------------------------
# Sadece MESSAGES_UPSERT gönderilir. `token` = config/local.php › WEBHOOK_SECRET_TOKEN ile AYNI değer.
# Evolution konteyneri bu adrese erişebilmeli (uygulama internetteyse genel HTTPS adresi).
WEBHOOK_URL=https://asya.scai.tr/api_whatsapp_webhook.php?token=BURAYA_WEBHOOK_SECRET_TOKEN
