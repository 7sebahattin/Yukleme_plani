# Hal Kayıt paneli — yalnızca index.php ve api.php doğrudan erişilebilir.
# (taslak_lib.php include-only ortak kütüphanedir — Beyan modülü de kullanır.)
# include-only PHP dosyaları, SPA kabuğu, şema ve kılavuz doğrudan çağrıya kapalı.

<FilesMatch "^(config|db|hks_soap|taslak_lib)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(html|sql|md)$">
    Require all denied
</FilesMatch>

# Apache 2.2 geriye dönük uyumluluk
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config|db|hks_soap|taslak_lib)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(html|sql|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Dizin listelemeyi kapat
Options -Indexes
DirectoryIndex index.php
